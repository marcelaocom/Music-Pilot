            let aReceberHoje = 0; let showsHoje = 0; let shows7Dias = 0; let proximosShows = []; let alertas = [];
            let projecao30Dias = 0;

            const dHojeObj = new Date(localDateString + 'T00:00:00'); 
            const d7Obj = new Date(dHojeObj); d7Obj.setDate(dHojeObj.getDate() + 7); const data7DiasStr = d7Obj.toISOString().split('T')[0];
