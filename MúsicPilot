            const dsh = document.getElementById('dashShowsHoje'); if(dsh) dsh.innerText = showsHoje;
            const ds7 = document.getElementById('dashShows7Dias'); if(ds7) ds7.innerText = shows7Dias;
            const dProj = document.getElementById('dashProjecao30Dias'); if(dProj) dProj.innerText = formatCurrency(projecao30Dias);

            proximosShows.sort((a,b) => new Date(`${a.date}T${a.time||'00:00'}`) - new Date(`${b.date}T${b.time||'00:00'}`));
            const dashUpcomingList = document.getElementById('dashUpcomingList');
