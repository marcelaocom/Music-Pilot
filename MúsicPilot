<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Quantum Control | Centro de Comando</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        /* TIPOGRAFIA OFICIAL */
        @import url('https://fonts.googleapis.com/css2?family=Exo+2:wght@300;400;500;600;700;800&display=swap');
        
        :root {
            /* ESTÉTICA FERRARI NEON (DESIGN SYSTEM) */
            --bg-main: #070707;
            --bg-sec: #101010;
            --bg-surface: #141414;
            --bg-elevated: #1B1B1B;
            
            --brand-primary: #D9111F;
            --brand-dark: #A40C16;
            --brand-glow: #FF2D3F;
            
            --text-main: #FFFFFF;
            --text-sec: #E4E4E4;
            --text-muted: #B7B7B7;
            --text-disabled: #5D5D5D;
            
            --border-cards: #2C1013;
            --border-inputs: #321214;
            
            --state-success: #27D980;
            --state-alert: #F5A623;
            --state-error: #FF4D4F;
            --state-info: #3B82F6;
        }

        body { 
            color: var(--text-main); 
            font-family: 'Exo 2', sans-serif; 
            background-color: var(--bg-main); 
        }
        
        #dynamic-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-size: cover; 
            background-position: center 0%;
            background-repeat: no-repeat;
            z-index: -2; transition: background-image 0.5s ease;
        }
        
        #bg-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(7, 7, 7, 0.90);
            z-index: -1; transition: background-color 0.3s ease;
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        }

        /* COMPONENTES ATÔMICOS */
        .card-bg, .kanban-col { 
            background: var(--bg-surface); 
            border: 1px solid var(--border-cards); 
            border-radius: 24px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
            transition: all 0.2s ease; 
        }
        
        .card-bg:hover {
            transform: scale(1.02);
            border-color: var(--brand-dark);
        }
        
        .sidebar { 
            background: var(--bg-sec); 
            border-right: 1px solid var(--border-cards);
        }
        
        /* INPUTS (Height 52, Radius 14, Padding 16) */
        .input-bg { 
            background: var(--bg-elevated) !important; 
            border: 1px solid var(--border-inputs) !important; 
            color: var(--text-main) !important; 
            height: 52px;
            border-radius: 14px !important;
            padding: 0 16px !important;
            transition: all 0.15s ease;
        }
        .input-bg:focus {
            border-color: var(--brand-primary) !important;
            box-shadow: 0 0 12px rgba(217, 17, 31, 0.35) !important;
            outline: none;
        }
        .input-bg:hover { border-color: var(--brand-primary) !important; }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--text-disabled); border-radius: 99px; }
        
        .tab-content.hidden { display: none !important; }
        .dragging { opacity: 0.4; border: 2px dashed var(--brand-primary); }
        .kanban-col.drag-over { background-color: rgba(217, 17, 31, 0.1) !important; }

        .app-h { height: 100dvh; }

        .smart-tip {
            position: relative; display: inline-flex; align-items: center; justify-content: center;
            width: 16px; height: 16px; background: rgba(255, 255, 255, 0.1); border-radius: 50%;
            font-size: 0.65rem; color: var(--text-main); cursor: help; margin-left: 4px; font-style: normal;
            font-weight: bold;
        }

        .smart-tip .tooltip-text {
            visibility: hidden; width: 220px; background-color: var(--bg-elevated); color: var(--text-main); text-align: center;
            border-radius: 14px; padding: 12px; position: absolute; z-index: 9999; bottom: 130%; left: 50%;
            margin-left: -110px; opacity: 0; transition: opacity 0.3s; font-weight: normal; font-size: 0.85rem;
            border: 1px solid var(--brand-primary); box-shadow: 0 8px 24px rgba(217,17,31,0.35);
        }

        .smart-tip:hover .tooltip-text { visibility: visible; opacity: 1; }

        /* BOTÕES DE ELITE (Height 52, Radius 16) */
        .btn-elite {
            background: linear-gradient(90deg, var(--brand-dark), var(--brand-primary), var(--brand-glow));
            color: #ffffff; border: none;
            height: 52px; padding: 0 24px; border-radius: 16px; font-weight: 700; cursor: pointer; text-transform: uppercase;
            transition: all 0.15s ease; box-shadow: 0 4px 15px rgba(217,17,31,0.35); display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .btn-elite:hover { box-shadow: 0 6px 20px rgba(255,45,63,0.50); transform: translateY(-2px); }

        .btn-secondary {
            background: transparent; color: var(--text-sec); border: 1px solid var(--text-disabled);
            height: 52px; padding: 0 24px; border-radius: 16px; font-weight: 600; cursor: pointer; transition: all 0.15s ease;
            display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .btn-secondary:hover { border-color: var(--brand-primary); color: var(--brand-primary); }

        .drag-drop-zone {
            border: 2px dashed var(--border-cards); border-radius: 24px; padding: 3rem; text-align: center;
            background: var(--bg-elevated); transition: all 0.3s ease;
        }
        .drag-drop-zone:hover { border-color: var(--brand-primary); box-shadow: 0 0 15px rgba(217,17,31,0.2); }
    </style>
</head>
<body class="flex app-h overflow-hidden antialiased selection:bg-[#D9111F] selection:text-white">

    <div id="dynamic-bg"></div>
    <div id="bg-overlay"></div>

    <div id="loginScreen" class="fixed inset-0 z-[100000] flex flex-col items-center justify-center p-4" style="background: rgba(7,7,7,0.85); backdrop-filter: blur(12px);">
        <div class="relative z-10 w-full max-w-sm card-bg p-8">
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-[#2C1013] text-[#D9111F] rounded-2xl flex items-center justify-center mx-auto mb-4 border border-[#D9111F]/30 shadow-[0_0_15px_rgba(217,17,31,0.3)]">
                    <i class="fa-solid fa-shield-halved text-2xl"></i>
                </div>
                <h2 class="text-2xl font-black text-white tracking-tight">Acesso Restrito</h2>
                <p class="text-xs text-[#B7B7B7] mt-2 uppercase tracking-widest font-bold">Quantum Control Elite</p>
            </div>
            <form id="authForm" class="space-y-5">
                <div>
                    <label class="block text-[10px] font-bold text-[#B7B7B7] uppercase tracking-wider mb-2">E-mail Operacional</label>
                    <input type="email" id="loginEmail" required class="w-full input-bg text-sm transition" placeholder="seu@email.com">
                </div>
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="block text-[10px] font-bold text-[#B7B7B7] uppercase tracking-wider">Senha de Segurança</label>
                        <span onclick="recuperarSenha(document.getElementById('loginEmail').value)" class="text-[10px] font-bold text-[#D9111F] hover:text-[#FF2D3F] cursor-pointer transition">Esqueceu?</span>
                    </div>
                    <div class="relative">
                        <input type="password" id="loginPassword" required class="w-full input-bg pr-10 text-sm transition" placeholder="••••••••">
                        <button type="button" onclick="togglePasswordVisibility('loginPassword', 'passwordEyeIcon')" class="absolute right-4 top-[15px] text-[#5D5D5D] hover:text-[#D9111F] transition">
                            <i class="fa-solid fa-eye" id="passwordEyeIcon"></i>
                        </button>
                    </div>
                </div>
                <div class="pt-4 space-y-3">
                    <button type="submit" id="btnLogar" class="w-full btn-elite text-sm"><i class="fa-solid fa-right-to-bracket"></i> Entrar no Sistema</button>
                    <button type="button" id="btnCriarConta" class="w-full btn-secondary text-sm"><i class="fa-solid fa-user-plus"></i> Criar Conta</button>
                </div>
            </form>
        </div>
    </div>

    <div id="securityLockScreen" class="hidden fixed inset-0 z-[200000] flex flex-col items-center justify-center p-4" style="background: rgba(7,7,7,0.92); backdrop-filter: blur(15px);">
        <div class="text-center mb-6">
            <div class="w-20 h-20 bg-[#2C1013] text-[#D9111F] rounded-full flex items-center justify-center mx-auto mb-4 border border-[#D9111F]/30 shadow-[0_0_20px_rgba(217,17,31,0.4)]">
                <i class="fa-solid fa-lock text-3xl"></i>
            </div>
            <h2 class="text-2xl font-black text-white tracking-tight">Sistema Bloqueado</h2>
            <p class="text-xs text-[#B7B7B7] mt-2 font-medium">Por segurança, digite sua senha para voltar.</p>
        </div>
        <div class="w-full max-w-xs space-y-4">
            <div class="relative">
                <input type="password" id="unlockPassword" class="w-full input-bg text-center text-sm transition" placeholder="Sua senha..." onkeypress="if(event.key === 'Enter') unlockSystem()">
                <button type="button" onclick="togglePasswordVisibility('unlockPassword', 'unlockEyeIcon')" class="absolute right-4 top-[15px] text-[#5D5D5D] hover:text-[#D9111F] transition">
                    <i class="fa-solid fa-eye" id="unlockEyeIcon"></i>
                </button>
            </div>
            <button onclick="unlockSystem()" class="w-full btn-elite text-sm"><i class="fa-solid fa-unlock"></i> Desbloquear</button>
            <button onclick="sairDoSistema()" class="w-full bg-transparent text-[#FF4D4F] hover:text-[#FF2D3F] font-bold py-2 rounded-xl text-xs transition">Fazer Logout</button>
        </div>
    </div>

    <aside class="sidebar w-[300px] flex flex-col justify-between p-6 hidden md:flex no-pdf z-50">
        <div>
            <div class="flex items-center gap-3 mb-10 cursor-pointer" onclick="triggerLogoUpload()" title="Alterar Logo">
                <div id="logoContainer" class="w-12 h-12 bg-[#2C1013] border border-[#D9111F]/40 rounded-[14px] flex items-center justify-center transition overflow-hidden shadow-[0_0_15px_rgba(217,17,31,0.2)]">
                    <i class="fa-solid fa-image text-[#D9111F]"></i>
                </div>
                <div onclick="editBrandText(); event.stopPropagation();">
                    <h2 id="companyTitle" class="font-bold text-white text-base hover:text-[#D9111F] transition">MARCELÃO.COM</h2>
                    <p id="companySubtitle" class="text-[10px] text-[#B7B7B7] uppercase tracking-widest hover:text-white transition">Painel de Controle</p>
                </div>
                <input type="file" id="logoUpload" accept="image/*" class="hidden" onchange="handleLogoUpload(event)">
            </div>
            
            <nav class="space-y-2">
                <button id="btnTabDashboard" onclick="switchTab('dashboard')" class="w-full flex items-center gap-4 h-[60px] px-4 rounded-[18px] hover:bg-[#2C1013] text-[#B7B7B7] hover:text-[#D9111F] transition group">
                    <i class="fa-solid fa-rocket w-5 text-center group-hover:drop-shadow-[0_0_8px_rgba(217,17,31,0.8)]"></i> 
                    <span class="text-sm font-bold tracking-wide">Centro de Comando</span>
                </button>
                <button id="btnTabFinanceiro" onclick="switchTab('financeiro')" class="w-full flex items-center gap-4 h-[60px] px-4 rounded-[18px] hover:bg-[#2C1013] text-[#B7B7B7] hover:text-[#D9111F] transition group">
                    <i class="fa-solid fa-chart-line w-5 text-center group-hover:drop-shadow-[0_0_8px_rgba(217,17,31,0.8)]"></i> 
                    <span class="text-sm font-bold tracking-wide">Inteligência Financeira</span>
                </button>
                <button id="btnTabAgenda" onclick="switchTab('agenda')" class="w-full flex items-center gap-4 h-[60px] px-4 rounded-[18px] hover:bg-[#2C1013] text-[#B7B7B7] hover:text-[#D9111F] transition group">
                    <i class="fa-solid fa-calendar-days w-5 text-center group-hover:drop-shadow-[0_0_8px_rgba(217,17,31,0.8)]"></i> 
                    <span class="text-sm font-bold tracking-wide">Logística Operacional</span>
                </button>
                <button id="btnTabCRM" onclick="switchTab('crm')" class="w-full flex items-center gap-4 h-[60px] px-4 rounded-[18px] hover:bg-[#2C1013] text-[#B7B7B7] hover:text-[#D9111F] transition group">
                    <i class="fa-solid fa-users w-5 text-center group-hover:drop-shadow-[0_0_8px_rgba(217,17,31,0.8)]"></i> 
                    <span class="text-sm font-bold tracking-wide flex items-center">Motor de Vendas</span>
                </button>
                <button id="btnTabJuridico" onclick="switchTab('juridico')" class="w-full flex items-center gap-4 h-[60px] px-4 rounded-[18px] hover:bg-[#2C1013] text-[#B7B7B7] hover:text-[#D9111F] transition group">
                    <i class="fa-solid fa-file-shield w-5 text-center group-hover:drop-shadow-[0_0_8px_rgba(217,17,31,0.8)]"></i> 
                    <span class="text-sm font-bold tracking-wide flex items-center">Segurança Jurídica</span>
                </button>
            </nav>
        </div>
        <div class="border-t border-[#2C1013] pt-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 cursor-pointer" onclick="toggleProfileModal()">
                    <div class="w-10 h-10 rounded-full bg-[#141414] border border-[#321214] flex items-center justify-center font-bold text-[#D9111F] text-xs">
                        <i class="fa-solid fa-fingerprint"></i>
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-xs font-bold text-white truncate hover:text-[#D9111F] transition">White Label</p>
                    </div>
                </div>
                <button onclick="sairDoSistema()" class="text-[#FF4D4F] hover:text-[#FF2D3F] transition p-2 rounded-lg hover:bg-[#2C1013]" title="Sair do Sistema">
                    <i class="fa-solid fa-power-off"></i>
                </button>
            </div>
        </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-4 md:p-8 pb-24 md:pb-8 relative" id="appContainer">

        <div id="viewDashboard" class="tab-content transition-all duration-300">
            <div class="mb-8 flex justify-between items-center no-pdf">
                <div>
                    <h1 class="text-[36px] font-black text-white mb-1"><i class="fa-solid fa-rocket mr-2 text-[#D9111F] drop-shadow-[0_0_8px_rgba(217,17,31,0.8)]"></i>Centro de Comando</h1>
                    <p class="text-sm text-[#B7B7B7] font-medium">Painel de métricas e controle de alta performance.</p>
                </div>
                <div class="text-right">
                    <p class="text-[12px] font-bold text-white uppercase tracking-widest bg-[#2C1013] px-4 py-2 rounded-lg border border-[#D9111F]/30 shadow-md font-mono" id="dashCurrentDate">Carregando data...</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
                <div class="card-bg p-6 border-l-4 border-[#27D980] relative overflow-hidden group">
                    <div class="absolute right-[-10px] top-[-10px] opacity-[0.03] text-8xl group-hover:opacity-10 transition-opacity text-[#27D980]"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                    <p class="text-[12px] text-[#B7B7B7] uppercase font-bold tracking-wider mb-2">A Receber Hoje (Shows)</p>
                    <h3 class="text-[32px] font-black text-[#27D980]" id="dashReceberHoje">R$ 0,00</h3>
                </div>
                <div class="card-bg p-6 border-l-4 border-[#D9111F] relative overflow-hidden group">
                    <div class="absolute right-[-10px] top-[-10px] opacity-[0.03] text-8xl group-hover:opacity-10 transition-opacity text-[#D9111F]"><i class="fa-solid fa-microphone-lines"></i></div>
                    <p class="text-[12px] text-[#B7B7B7] uppercase font-bold tracking-wider mb-2">Shows Marcados (Hoje)</p>
                    <h3 class="text-[32px] font-black text-white" id="dashShowsHoje">0</h3>
                </div>
                <div class="card-bg p-6 border-l-4 border-[#F5A623] relative overflow-hidden group">
                    <div class="absolute right-[-10px] top-[-10px] opacity-[0.03] text-8xl group-hover:opacity-10 transition-opacity text-[#F5A623]"><i class="fa-solid fa-calendar-week"></i></div>
                    <p class="text-[12px] text-[#B7B7B7] uppercase font-bold tracking-wider mb-2">Shows (Próximos 7 Dias)</p>
                    <h3 class="text-[32px] font-black text-white" id="dashShows7Dias">0</h3>
                </div>
                <div class="card-bg p-6 border-l-4 border-[#D4AF37] relative overflow-hidden group">
                    <div class="absolute right-[-10px] top-[-10px] opacity-[0.03] text-8xl group-hover:opacity-10 transition-opacity text-[#D4AF37]"><i class="fa-solid fa-money-bill-trend-up"></i></div>
                    <p class="text-[12px] text-[#B7B7B7] uppercase font-bold tracking-wider mb-2">Projeção (Próximos 30 Dias)</p>
                    <h3 class="text-[32px] font-black text-[#D4AF37]" id="dashProjecao30Dias">R$ 0,00</h3>
                    <p class="text-[10px] text-[#5D5D5D] mt-2 font-bold">Lucro projetado baseado na agenda.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <div class="card-bg p-6">
                    <div class="flex items-center gap-2 mb-6 pb-4 border-b border-[#2C1013]">
                        <i class="fa-solid fa-chart-column text-sm text-[#D9111F]"></i>
                        <h3 class="text-[14px] font-bold text-white uppercase tracking-wider">Faturamento Anual (Contratado)</h3>
                    </div>
                    <div class="relative h-[300px] w-full"><canvas id="chartFaturamento"></canvas></div>
                </div>
                <div class="card-bg p-6">
                    <div class="flex items-center gap-2 mb-6 pb-4 border-b border-[#2C1013]">
                        <i class="fa-solid fa-map-location-dot text-sm text-[#F5A623]"></i>
                        <h3 class="text-[14px] font-bold text-white uppercase tracking-wider">Mapa Logístico (Shows por Zona)</h3>
                    </div>
                    <div class="relative h-[300px] w-full flex items-center justify-center"><canvas id="chartZonas"></canvas></div>
                </div>
            </div>

            <div class="card-bg p-6">
                <div class="flex items-center gap-2 mb-4 pb-4 border-b border-[#2C1013]">
                    <i class="fa-solid fa-bolt text-sm text-[#F5A623]"></i>
                    <h3 class="text-[14px] font-bold text-white uppercase tracking-wider">Radar de Eventos (Próximos Shows)</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="text-[11px] font-bold uppercase tracking-wider text-[#B7B7B7] border-b border-[#2C1013]">
                                <th class="pb-3">Data / Hora</th>
                                <th class="pb-3">Cliente / Serviço</th>
                                <th class="pb-3">Status</th>
                            </tr>
                        </thead>
                        <tbody id="dashUpcomingList" class="text-[14px] divide-y divide-[#2C1013]">
                            <tr><td colspan="3" class="text-center py-6 text-[#5D5D5D]">Aguardando dados...</td></tr>
                        </tbody>
                    </table>
                </div>
                <button onclick="switchTab('agenda')" class="w-full mt-6 text-[12px] font-bold text-[#D9111F] hover:text-[#FF2D3F] uppercase tracking-widest text-center transition">Ver Agenda Completa <i class="fa-solid fa-arrow-right ml-1"></i></button>
            </div>
        </div>
<div id="viewFinanceiro" class="tab-content hidden transition-all duration-300">
            <div class="flex justify-between items-center mb-8 no-pdf">
                <div>
                    <h1 class="text-[36px] font-black text-white tracking-tight"><i class="fa-solid fa-chart-line mr-2 text-[#27D980] drop-shadow-[0_0_8px_rgba(39,217,128,0.6)]"></i>Inteligência Financeira</h1>
                    <p class="text-sm text-[#B7B7B7] font-medium mt-1">Visão geral do fluxo de caixa e resultados preditivos.</p>
                </div>
                <div class="flex items-center gap-4">
                    <button onclick="clearAllData()" class="hidden md:flex text-[12px] bg-transparent hover:bg-[#FF4D4F]/10 text-[#FF4D4F] font-bold py-3 px-5 rounded-xl border border-[#FF4D4F]/30 transition items-center gap-2"><i class="fa-solid fa-trash-can"></i> Limpar Dados</button>
                    <button onclick="exportToPDF()" class="btn-secondary text-[12px]"><i class="fa-solid fa-download text-[#D9111F]"></i> Tela PDF</button>
                </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="card-bg p-6 flex items-center justify-between">
                    <div>
                        <p class="text-[12px] font-bold text-[#27D980] tracking-wider mb-2 uppercase">Total Entradas</p>
                        <p class="text-[32px] font-black text-white tracking-tight" id="totalIncomes">R$ 0,00</p>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-[#27D980]/10 border border-[#27D980]/30 flex items-center justify-center text-[#27D980]">
                        <i class="fa-solid fa-arrow-trend-up text-xl"></i>
                    </div>
                </div>
                <div class="card-bg p-6 flex items-center justify-between">
                    <div>
                        <p class="text-[12px] font-bold text-[#FF4D4F] tracking-wider mb-2 uppercase">Total Saídas</p>
                        <p class="text-[32px] font-black text-white tracking-tight" id="totalExpenses">R$ 0,00</p>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-[#FF4D4F]/10 border border-[#FF4D4F]/30 flex items-center justify-center text-[#FF4D4F]">
                        <i class="fa-solid fa-arrow-trend-down text-xl"></i>
                    </div>
                </div>
                <div class="card-bg p-6 flex items-center justify-between relative overflow-hidden group">
                    <div class="absolute inset-0 bg-gradient-to-r from-[#D9111F]/10 to-transparent opacity-50 group-hover:opacity-100 transition-opacity"></div>
                    <div class="relative z-10">
                        <p class="text-[12px] font-bold text-[#D9111F] tracking-wider mb-2 uppercase">Saldo Disponível</p>
                        <p class="text-[32px] font-black text-white tracking-tight" id="totalBalance">R$ 0,00</p>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-[#D9111F]/20 border border-[#D9111F]/40 flex items-center justify-center text-[#FF2D3F] relative z-10 shadow-[0_0_15px_rgba(217,17,31,0.3)]">
                        <i class="fa-solid fa-dollar-sign text-xl"></i>
                    </div>
                </div>
