<script>
        // =========================================================================
        // FUNÇÃO: ALTERAR SENHA VIA EMAIL
        // =========================================================================
        window.enviarLinkTrocaSenha = async function() {
            try {
                const { sendPasswordResetEmail } = await import("https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js");
                const email = window.auth.currentUser.email;
                if(confirm(`Deseja enviar um e-mail de redefinição de senha para ${email}?`)) {
                    sendPasswordResetEmail(window.auth, email).then(() => {
                        alert("E-mail de redefinição enviado com sucesso! Verifique sua caixa de entrada e SPAM.");
                    }).catch((err) => { alert("Erro ao enviar e-mail: " + err.message); });
                }
            } catch(e) { console.error(e); }
        };

        const WPP_TEMPLATES = {
            crm: "Olá, {{nome}}! Tudo bem? Sou do atendimento do Marcelão.com. Passando para conversar sobre o seu evento. Podemos fechar os detalhes?",
            agenda: "Fala, {{nome}}! Seu evento no dia {{data}} está confirmadíssimo na nossa agenda. O valor acordado foi R$ {{valor}}. Qualquer dúvida, estou à disposição!"
        };

        window.dispararWhatsApp = function(btnElement, contexto) {
            const nome = btnElement.getAttribute('data-nome') || 'Cliente';
            const telefone = btnElement.getAttribute('data-telefone') || '';
            const dataEvento = btnElement.getAttribute('data-data') || '';
            const valor = btnElement.getAttribute('data-valor') || '';

            if (!telefone || telefone.trim() === '+55' || telefone === 'N/A') { alert("Número não encontrado."); return; }

            const numeroLimpo = telefone.replace(/\D/g, '');
            let mensagem = WPP_TEMPLATES[contexto] || WPP_TEMPLATES.crm;
            mensagem = mensagem.replace('{{nome}}', nome).replace('{{data}}', dataEvento).replace('{{valor}}', valor);

            const dataAcao = formatDateBR(localDateString);
            const notaWpp = `[WPP] Mensagem enviada via Botão Mágico em ${dataAcao}.`;

            let lead = crmProvaveis.find(p => p.phone === telefone || p.name === nome);
            if(lead) {
                lead.notes = lead.notes ? `${lead.notes} | ${notaWpp}` : notaWpp;
                localStorage.setItem('crmProvaveis', JSON.stringify(crmProvaveis));
            } else {
                let efetivado = crmEfetivados.find(c => c.contact === telefone || c.clientName === nome);
                if(efetivado && efetivado.servicesHistory.length > 0) {
                    efetivado.servicesHistory[0].notes = efetivado.servicesHistory[0].notes ? `${efetivado.servicesHistory[0].notes} | ${notaWpp}` : notaWpp;
                    localStorage.setItem('crmEfetivados', JSON.stringify(crmEfetivados));
                }
            }
            if (typeof renderApp === "function") renderApp();

            const iconeOriginal = btnElement.innerHTML;
            btnElement.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-sm"></i>';
            setTimeout(() => {
                const url = `https://wa.me/55${numeroLimpo}?text=${encodeURIComponent(mensagem)}`;
                window.open(url, '_blank');
                btnElement.innerHTML = iconeOriginal;
            }, 600);
        };

        function capturarLeadPorLink() {
            const params = new URLSearchParams(window.location.search);
            const leadName = params.get('novoLead');
            const leadPhone = params.get('telefone');
            if(leadName && leadPhone) {
                crmProvaveis.push({ 
                    id: generateId(), name: leadName, phone: `+55 (${leadPhone.substring(0,2)}) ${leadPhone.substring(2,7)}-${leadPhone.substring(7,11)}`, stage: 'Lead', notes: '⭐ Capturado via link externo.' 
                });
                localStorage.setItem('crmProvaveis', JSON.stringify(crmProvaveis));
                window.history.replaceState({}, document.title, window.location.pathname);
                alert(`Lead [${leadName}] capturado!`);
                if (typeof renderApp === "function") renderApp();
            }
        }

        function toggleTheme() { document.body.classList.toggle('light-mode'); const isLight = document.body.classList.contains('light-mode'); localStorage.setItem('theme', isLight ? 'light' : 'dark'); if(typeof renderCharts === 'function') renderCharts(); }
        if(localStorage.getItem('theme') === 'light') document.body.classList.add('light-mode');

        function toggleProfileModal() {
            const modal = document.getElementById('profileModal');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) {
                const profile = JSON.parse(localStorage.getItem('companyProfile')) || {};
                document.getElementById('profName').value = localStorage.getItem('companyTitle') || 'MARCELÃO.COM';
                document.getElementById('profDoc').value = profile.doc || '';
                document.getElementById('profPhone').value = profile.phone || '';
                document.getElementById('profAddress').value = profile.address || '';
            }
        }

        function handleProfileSubmit(e) {
            e.preventDefault();
            const phone = document.getElementById('profPhone').value;
            const address = document.getElementById('profAddress').value;
            const oldProfile = JSON.parse(localStorage.getItem('companyProfile')) || {};
            const doc = oldProfile.doc || document.getElementById('profDoc').value;
            const name = localStorage.getItem('companyTitle') || document.getElementById('profName').value;
            
            localStorage.setItem('companyTitle', name);
            localStorage.setItem('companyProfile', JSON.stringify({ doc, phone, address }));
            loadSavedBrandData(); toggleProfileModal();
            alert('Identidade salva!');
        }

        function loadSavedBrandData() {
            const title = localStorage.getItem('companyTitle') || 'MARCELÃO.COM';
            const logo = localStorage.getItem('companyLogo');
            const bg = localStorage.getItem('appBackground');
            const titleNodes = document.querySelectorAll('#companyTitle');
            titleNodes.forEach(n => n.innerText = title);
            const logoContainer = document.getElementById('logoContainer');
            if (logoContainer) {
                if (logo) logoContainer.innerHTML = `<img src="${logo}" class="w-full h-full object-cover">`;
                else logoContainer.innerHTML = `<i class="fa-solid fa-image text-[#D9111F]"></i>`;
            }
            const dynamicBg = document.getElementById('dynamic-bg');
            if (dynamicBg) {
                if (bg) dynamicBg.style.backgroundImage = `url('${bg}')`;
                else dynamicBg.style.backgroundImage = 'none';
            }
