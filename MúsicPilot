                    if (a.status !== 'Concluido') { const adiant = a.advanceValue || 0; const total = a.value || 0; aReceberHoje += (total - adiant); } 
                }
                if (a.date >= localDateString && a.date <= data7DiasStr) { shows7Dias++; proximosShows.push(a); }
                if (a.status === 'Agendado' && a.date >= localDateString && a.date <= data30DiasStr) {
